#!/usr/bin/env bash
# Satay pre-push hook — mirrors the cheap CI gates (ruff + mypy + unit tests).
# Bypass with:  git push --no-verify
set -euo pipefail

echo "[pre-push] ruff check ..."
uv run ruff check .

echo "[pre-push] ruff format --check ..."
uv run ruff format --check .

echo "[pre-push] mypy --strict ..."
uv run mypy src

echo "[pre-push] pytest tests/unit ..."
uv run pytest tests/unit -q

echo "[pre-push] OK"
